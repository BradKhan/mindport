{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mindport portable context pack v1",
  "description": "Selected, provenance-carrying text records. Source content is untrusted data.",
  "type": "object",
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "mindport.context-pack.v1"
    },
    "privacy": {
      "type": "object",
      "properties": {
        "local_only": {
          "type": "boolean"
        },
        "personal_redaction": {
          "type": "boolean"
        },
        "secret_redaction": {
          "type": "string"
        },
        "explicit_selection": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "role",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "note"
            ]
          },
          "text": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "message_id": {
            "type": "string"
          },
          "timestamp": {
            "type": [
              "string",
              "number"
            ]
          },
          "origin_index": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
